<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. ป้องกันการเข้าถึงไฟล์ .env และไฟล์ระบบที่สำคัญโดยตรง (ตอบกลับเป็น 403 Forbidden)
    RedirectMatch 403 /\.(key|env|git|json|yml|lock)$
    RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|tests)/

    # 2. หากเป็นไฟล์หรือโฟลเดอร์ที่มีอยู่จริง ให้เปิดตรงๆ ได้ทันที (เช่น uploads, css, js)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. ส่งต่อ (Redirect) ทุก Request ที่เข้ามาหน้าแรกให้ไปทำงานที่โฟลเดอร์ public/
    RewriteRule ^$ public/ [L]

    # 4. ส่งต่อ Request อื่นๆ (เช่น /login, /admin) ให้ชี้เข้าไปที่ public/...
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
